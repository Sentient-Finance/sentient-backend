APP_ENV=dev
APP_PORT=8000

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sentient
POSTGRES_USER=sentient
POSTGRES_PASSWORD=sentient

REDIS_URL=redis://127.0.0.1:6379/0

ETH_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=

# EVM deploy wallet (NEVER commit real key)
DEPLOY_PRIVATE_KEY=

# OpenClaw webhook bridge (see docs/security/credential-rotation.md)
OPENCLAW_HOOK_URL=
OPENCLAW_HOOK_TOKEN=
CHAINLINK_FEED_REGISTRY_ADDRESS=
CHAINLINK_CRE_EXECUTE_URL=
CHAINLINK_CRE_API_KEY=
CHAINLINK_CRE_TIMEOUT_SECONDS=30
# CCIP chain metadata used by shield action validation.
# Option A: inline JSON (small setups)
# CHAINLINK_CCIP_CHAINS_JSON={"84532":{"router":"0x...","linkToken":"0x..."},"ethereum-testnet-sepolia-1":{"selector":"16015286601757825753"}}
CHAINLINK_CCIP_CHAINS_JSON=
# Option B: file path (recommended for larger config)
# CHAINLINK_CCIP_CHAINS_FILE=./config/ccip_chains.json
CHAINLINK_CCIP_CHAINS_FILE=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

MAX_NOTIONAL_PER_TRADE=0
MAX_DAILY_NOTIONAL=0
MAX_OPEN_POSITIONS=0

INDEXER_POLL_INTERVAL_SECONDS=10
INDEXER_START_BLOCK=
INDEXER_BATCH_SIZE=1000

# Optional DSN overriding the composed Postgres URL above
DATABASE_URL=

