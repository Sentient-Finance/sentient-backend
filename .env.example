# Production Deployment (Traefik)
DOMAIN=api.sentient-finance.duckdns.org
ACME_EMAIL=your-email@example.com
DOCKER_PROXY_NETWORK=sentient-proxy

APP_ENV=dev
APP_PORT=8000

# Postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sentient
POSTGRES_USER=sentient
POSTGRES_PASSWORD=sentient

# Optional: overrides the composed Postgres URL above
DATABASE_URL=

# Redis (Celery worker)
REDIS_URL=redis://127.0.0.1:6379/0

# RPC
ETH_RPC_URL=
BASE_RPC_URL=
ARBITRUM_RPC_URL=

# Chainlink
CHAINLINK_FEED_REGISTRY_ADDRESS=

# Indexer
SUBGRAPH_API_KEY=
SUBGRAPH_ID=
SUBGRAPH_URL=
CHAIN_BASE_SEPOLIA_ID=84532
INDEXER_TICK_SECONDS=10
INDEXER_START_BLOCK=
INDEXER_BATCH_SIZE=1000

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading risk limits
MAX_NOTIONAL_PER_TRADE=0
MAX_DAILY_NOTIONAL=0
MAX_OPEN_POSITIONS=0

# Worker timing
STRATEGY_TICK_SECONDS=60
RISK_TICK_SECONDS=60
STALE_PRICE_SECONDS=180
EXECUTION_COOLDOWN_SECONDS=3600
ALERT_DEDUPE_SECONDS=300

# Rate Limits
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_HEAVY=20/minute

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Executor wallet
EXECUTOR_PRIVATE_KEY=
EXECUTOR_DRY_RUN=true
EXECUTOR_GAS_LIMIT=350000

# Base token (USDC on Base Sepolia)
BASE_TOKEN_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
