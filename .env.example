APP_ENV=dev
APP_PORT=8000

# Postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sentient
POSTGRES_USER=sentient
POSTGRES_PASSWORD=sentient

# Optional: overrides the composed Postgres URL above
DATABASE_URL=

# Redis (Celery worker)
REDIS_URL=redis://127.0.0.1:6379/0

# RPC — INDEXER_RPC_URL takes priority; BASE_RPC_URL used as fallback
INDEXER_RPC_URL=
BASE_RPC_URL=
ETH_RPC_URL=
ARBITRUM_RPC_URL=

# Chainlink
CHAINLINK_FEED_REGISTRY_ADDRESS=

# Indexer — sync from subgraph into Postgres
# Option A: Gateway (subgraph must be Published to Network)
SUBGRAPH_API_KEY=
SUBGRAPH_ID=
# Option B: Studio URL — set if Gateway 403 (for fallback) or Studio-only
# SUBGRAPH_URL=https://api.studio.thegraph.com/query/1743020/subgraph-base-testnet/version/latest
CHAIN_BASE_SEPOLIA_ID=84532
INDEXER_CONTRACTS=
INDEXER_CHAIN_ID=
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_INTERVAL_SECONDS=10
INDEXER_START_BLOCK=
INDEXER_BATCH_SIZE=1000

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading risk limits
MAX_NOTIONAL_PER_TRADE=0
MAX_DAILY_NOTIONAL=0
MAX_OPEN_POSITIONS=0

# Worker timing
STRATEGY_TICK_SECONDS=60
RISK_TICK_SECONDS=60
STALE_PRICE_SECONDS=180
ALERT_DEDUPE_SECONDS=300

# Rate Limits
RATE_LIMIT_PUBLIC=60/minute
RATE_LIMIT_HEAVY=20/minute
