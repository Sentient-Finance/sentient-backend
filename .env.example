APP_ENV=dev
APP_PORT=8000

# Postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=sentient
POSTGRES_USER=sentient
POSTGRES_PASSWORD=sentient

# Optional: overrides the composed Postgres URL above
DATABASE_URL=

# Redis (Celery worker)
REDIS_URL=redis://127.0.0.1:6379/0

# RPC — INDEXER_RPC_URL takes priority; BASE_RPC_URL used as fallback
INDEXER_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://sepolia.base.org
ETH_RPC_URL=
ARBITRUM_RPC_URL=

# Chainlink
CHAINLINK_FEED_REGISTRY_ADDRESS=

# Indexer
INDEXER_CONTRACTS=0x04c0599ae5a44757c0af6f9ec3b93da8976c150a
INDEXER_CHAIN_ID=84532
INDEXER_CONFIRMATIONS=2
INDEXER_POLL_INTERVAL_SECONDS=10
INDEXER_START_BLOCK=42780426
INDEXER_BATCH_SIZE=1000

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Trading risk limits
MAX_NOTIONAL_PER_TRADE=0
MAX_DAILY_NOTIONAL=0
MAX_OPEN_POSITIONS=0
